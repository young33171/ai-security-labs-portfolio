    "def closest_images(mean_image, count=100):\n",
    "    # 300ìž¥ ê°ê°ê³¼ í‰ê·  ì´ë¯¸ì§€ ì‚¬ì´ì˜ í‰ê·  ì ˆëŒ€ ì˜¤ì°¨ë¥¼ êµ¬í•©ë‹ˆë‹¤.\n",
    "    abs_diff = np.abs(fruits - mean_image)\n",
    "    distances = np.mean(abs_diff, axis=(1, 2))\n",
    "    # ê±°ë¦¬ê°€ ìž‘ì€ ìˆœì„œëŒ€ë¡œ countê°œì˜ ì¸ë±ìŠ¤ë¥¼ ë°˜í™˜í•©ë‹ˆë‹¤.\n",
    "    return np.argsort(distances)[:count], distances\n",
    "\n",
    "banana_index, banana_distance = closest_images(banana_mean, 100)\n",
    "pineapple_index, pineapple_distance = closest_images(pineapple_mean, 100)\n",
